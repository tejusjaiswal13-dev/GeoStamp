<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Camera Top Prism / Viewfinder Bump -->
    <path
        android:pathData="M 45,35 L 47,31 C 47.6,29.8 48.8,29 50.2,29 L 57.8,29 C 59.2,29 60.4,29.8 61,31 L 63,35 Z"
        android:fillColor="#CBD5E1" />

    <!-- Camera Main Body with smooth rounded corners -->
    <path
        android:pathData="M 34,35 L 74,35 C 79.5,35 84,39.5 84,45 L 84,71 C 84,76.5 79.5,81 74,81 L 34,81 C 28.5,81 24,76.5 24,71 L 24,45 C 24,39.5 28.5,35 34,35 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="35"
                android:endX="84"
                android:endY="81"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#E2E8F0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Camera Flash Element -->
    <path
        android:pathData="M 72,42 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0"
        android:fillColor="#38BDF8" />

    <!-- Outer Lens Ring (Metallic dark slate) -->
    <path
        android:pathData="M 54,58 m -18,0 a 18,18 0 1,0 36,0 a 18,18 0 1,0 -36,0"
        android:fillColor="#1E293B" />

    <!-- Secondary Lens Aperture Bevel -->
    <path
        android:pathData="M 54,58 m -15,0 a 15,15 0 1,0 30,0 a 15,15 0 1,0 -30,0"
        android:fillColor="#0F172A" />

    <!-- Lens Optical Glass Layer with deep blue tint -->
    <path
        android:pathData="M 54,58 m -12.5,0 a 12.5,12.5 0 1,0 25,0 a 12.5,12.5 0 1,0 -25,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="46"
                android:endX="66"
                android:endY="70"
                android:type="linear">
                <item android:color="#0369A1" android:offset="0.0" />
                <item android:color="#0C4A6E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- GPS Crosshairs / Calibration Ticks on Lens -->
    <path
        android:pathData="M 54,46 L 54,48 M 54,68 L 54,70 M 42,58 L 44,58 M 64,58 L 66,58"
        android:strokeWidth="1.2"
        android:strokeColor="#7DD3FC"
        android:strokeLineCap="round" />

    <!-- GPS Geotag Location Pin (Integrated at Lens Center) -->
    <path
        android:pathData="M 54,49 C 50.7,49 48,51.7 48,55 C 48,59.5 54,66 54,66 C 54,66 60,59.5 60,55 C 60,51.7 57.3,49 54,49 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="49"
                android:endX="60"
                android:endY="66"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pin Inner Core / Camera Aperture Eye -->
    <path
        android:pathData="M 54,55 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#FFFFFF" />

</vector>